# ============================================================
# KARIERLENS ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env.local:
#   Copy-Item .env.local.example .env.local
# JANGAN meng-commit file .env.local yang berisi kunci asli.
# ============================================================

# --- OPSI 1: Google Gemini (Disarankan) ---
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=isi_api_key_gemini_di_sini

# Base URL untuk Gemini (Google menyediakan OpenAI-compatible endpoint resmi):
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model Gemini yang digunakan (contoh: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- OPSI 2: tokengateway.dev / DeepSeek (Alternatif) ---
# DEEPSEEK_API_KEY=isi_api_key_tokengateway_di_sini
# DEEPSEEK_BASE_URL=https://tokengateway.dev/v1
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_DISABLE_THINKING=true

# Batas panggilan per IP per 10 menit (melindungi kuota jika URL dipublikasikan)
RATE_LIMIT_PER_10MIN=40
